# =============================================================================
# main.env — Global Agent Configuration
# =============================================================================

# --- Runtime ---
RUNTIME="gemini"

# --- Gemini Multimodal Config ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# --- Evaluation ---
EVAL_EPISODES=1

# --- Active Gym Environment ---
# ENV_TYPE="minigrid_empty"
# ENV_TYPE="vizdoom_basic"
ENV_TYPE="vizdoom_predict"
# ENV_TYPE="babyai_unlock_pickup"

# GYM_ENVIRONMENT="MiniGrid-Empty-8x8-v0"
# GYM_ENVIRONMENT="VizdoomBasic-v1"
GYM_ENVIRONMENT="VizdoomPredictPosition-v1"
# GYM_ENVIRONMENT="BabyAI-UnlockPickup-v0"



# --- Render Mode ---
# "human"     - live display window
# "record"    - save video to outputs/recordings/
# "rgb_array" - headless, frames passed to VLM only
RENDER_MODE="record"

# --- Memory ---
# Valid modes: 'sqlite', 'in_memory'
MEMORY_SYSTEM="in_memory"
MEMORY_DB_PATH="outputs/memory.db"
MAX_MEMORY_HISTORY=5
